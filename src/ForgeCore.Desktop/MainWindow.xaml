<Window x:Class="ForgeCore.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForgeCore · Local Development Assistant" Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource Background}">
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0D131B" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="12" Background="#16362F" BorderBrush="#2B6B5E" BorderThickness="1">
          <TextBlock Text="FC" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,1,20,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="ForgeCore" FontSize="21" FontWeight="SemiBold"/>
            <Border Background="#152438" BorderBrush="#294466" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="10,1,0,0">
              <TextBlock Text="v0.14  TRUSTED PROJECT AUTOMATION" Foreground="#8EB5FF" FontSize="9" FontWeight="Bold"/>
            </Border>
          </StackPanel>
          <TextBlock Text="Private local model · typed Unity control" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#102720" BorderBrush="#245548" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0"/><TextBlock Text="LOCAL MODEL" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/></StackPanel>
          </Border>
          <Border Background="#152438" BorderBrush="#294466" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,10,0">
            <TextBlock Text="{Binding UnityAiStatus}" Foreground="#8EB5FF" FontSize="10" FontWeight="Bold"/>
          </Border>
          <Button Style="{StaticResource WarningButton}" Command="{Binding AuthorizationCommand}" Content="{Binding AuthorizationButtonText}"
                  ToolTip="{Binding AuthorizationHint}" Margin="0,0,10,0"/>
          <Button Style="{StaticResource DangerButton}" Command="{Binding EmergencyStopCommand}" ToolTip="Immediately cancel all work until ForgeCore restarts">
            <StackPanel Orientation="Horizontal"><TextBlock Text="■" FontSize="10" Margin="0,0,8,0"/><TextBlock Text="EMERGENCY STOP"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="2,2,2,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="CONVERSATIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Local history" Style="{StaticResource SectionTitle}" Margin="0,5,0,0"/></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="＋" Width="38" Padding="0" FontSize="18" Command="{Binding NewConversationCommand}" ToolTip="New conversation"/>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Margin="0,0,0,10">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Item" CornerRadius="8" Padding="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#152B2A"/><Setter TargetName="Item" Property="BorderBrush" Value="#28564F"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource PanelHover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:dd MMM · h:mm tt}}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2">
            <Button Content="Open selected conversation" Command="{Binding LoadConversationCommand}"/>
            <Border Background="#0C151A" BorderBrush="#1E3B3A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
              <StackPanel><TextBlock Text="PRIVACY BOUNDARY" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
                <TextBlock Text="Memory and project indexes stay on this device." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="ACTIVE CONVERSATION" Style="{StaticResource Eyebrow}"/><TextBlock Text="ForgeCore workspace session" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
              <Border Grid.Column="1" Background="#121F2C" BorderBrush="#273C51" BorderThickness="1" CornerRadius="10" Padding="9,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Blue}" Margin="0,0,6,0"/><TextBlock Text="{Binding AgentState}" Foreground="#AFC6FF" FontSize="10" FontWeight="SemiBold"/></StackPanel>
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
          <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Padding="16,12" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate><DataTemplate>
              <Border MaxWidth="760" Margin="0,5" Padding="14,11" CornerRadius="10" BorderThickness="1">
                <Border.Style><Style TargetType="Border">
                  <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="#15312C"/><Setter Property="BorderBrush" Value="#2A5D53"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel><TextBlock Text="{Binding DisplayRole}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,5"/>
                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"/></StackPanel>
              </Border></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="360">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=MessageList, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Border Width="56" Height="56" CornerRadius="16" Background="#14312B" BorderBrush="#285E53" BorderThickness="1" HorizontalAlignment="Center">
              <TextBlock Text="FC" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Ready when you are" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="Ask about a project, request a safe code change, or have a private local conversation." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" Margin="0,8,0,0"/>
          </StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="#0D141C" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MinHeight="88" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       FontSize="13.5" ToolTip="Describe a coding or workspace task"/>
              <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Up to four tasks may progress; approvals still gate the task that requested them." Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Style="{StaticResource GhostButton}" Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,0"/>
                  <Button Style="{StaticResource PrimaryButton}" Content="Send request  →" Command="{Binding SendCommand}" MinWidth="132"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="12"/><RowDefinition Height="1.4*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Margin="2,2,2,9"><TextBlock Text="TASK QUEUE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Current work" Style="{StaticResource SectionTitle}" Margin="0,5,0,0"/><TextBlock Text="{Binding PendingApprovalStatus}" Foreground="#FFD791" FontSize="9.5" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding PendingApprovals}" MaxHeight="180" Margin="0,0,0,7">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="#2A2115" BorderBrush="#735727" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,2">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Detail}" Foreground="#D9B56A" FontSize="9.5" Margin="0,3,0,6"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Reject" Padding="9,4" Margin="0,0,6,0"
                            Command="{Binding DataContext.RejectPendingCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Approve" Padding="9,4"
                            Command="{Binding DataContext.ApprovePendingCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ListBox Grid.Row="2" ItemsSource="{Binding Tasks}"><ListBox.ItemTemplate><DataTemplate>
            <Border Background="#121B25" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,2">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{StaticResource Blue}" CornerRadius="2" Margin="0,1,9,1"/><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"/></Grid>
            </Border>
          </DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid></Border>

        <Border Grid.Row="2" Style="{StaticResource Card}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Margin="2,2,2,9"><TextBlock Text="AUDIT STREAM" Style="{StaticResource Eyebrow}"/><TextBlock Text="Security activity" Style="{StaticResource SectionTitle}" Margin="0,5,0,0"/></StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Activity}" Foreground="{StaticResource Muted}"><ListBox.ItemTemplate><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" LineHeight="15" Margin="2,3"/>
          </DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid></Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
          <StackPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="LOCAL SYSTEM" Style="{StaticResource Eyebrow}"/><TextBlock Text="Runtime status" Style="{StaticResource SectionTitle}" Margin="0,5,0,0"/></StackPanel>
            <Border Grid.Column="1" Background="#102720" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="UNITY · GUARDED" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/></Border>
          </Grid>
          <UniformGrid Columns="3">
            <Border Background="#0C1219" CornerRadius="7" Padding="8" Margin="0,0,5,0"><TextBlock Text="{Binding CpuStatus}" TextAlignment="Center" FontSize="10.5"/></Border>
            <Border Background="#0C1219" CornerRadius="7" Padding="8" Margin="2.5,0"><TextBlock Text="{Binding RamStatus}" TextAlignment="Center" FontSize="10.5"/></Border>
            <Border Background="#0C1219" CornerRadius="7" Padding="8" Margin="5,0,0,0"><TextBlock Text="{Binding GpuStatus}" TextAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis"/></Border>
          </UniformGrid>
          <TextBlock Text="{Binding ModelStatus}" Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="2,10,2,0"/>
          <TextBlock Text="{Binding SeeleStatus}" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="Bold" Margin="2,6,2,0"/>
          <TextBlock Text="{Binding MeshyStatus}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" Margin="2,4,2,0"/>
          <TextBlock Text="{Binding GameplayEvidenceStatus}" Foreground="#AFC6FF" FontSize="10" FontWeight="Bold" Margin="2,4,2,0"/>
          <Border Background="#352815" BorderBrush="#735727" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,9,0,0">
            <TextBlock Text="{Binding AuthorizationStatus}" Foreground="#FFD791" TextAlignment="Center" FontSize="9.5" FontWeight="Bold"/>
          </Border>
        </StackPanel></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
